{
  "name": "nextify-middleware",
  "version": "0.1.0",
  "description": "express middleware for generating *nextjs-like* filesystem based router with typescript handlers, handlebars templates and htmx",
  "main": "dist/index.js",
  "scripts": {
    "test": "npm run build && npm link nextify-middleware && jest --silent=false --verbose",
    "build": "rimraf dist && tsc --project ./tsconfig.json && cp default/**.{tsx,ts} dist/default",
    "prepare": "npm run build"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "esbuild": "^0.24.0",
    "esbuild-css-injector-ssr-plugin": "kostyatam/esbuild-css-injector-ssr-plugin#main"
  },
  "peerDependencies": {
    "@types/express": "^5.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "express": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.1",
    "express": "^5.0.0",
    "jest": "^29.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^5.0.5",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "typescript": "^5.7.2"
  }
}
